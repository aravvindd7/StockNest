# Server
PORT=5001
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/stocknest

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_before_deploying
JWT_EXPIRES_IN=8h

# CORS - frontend origin
CLIENT_URL=http://localhost:5173

# Seed accounts (used only by seed/seedUsers.js)
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_EMAIL=employee@company.com
SEED_USER_PASSWORD=Employee@12345
