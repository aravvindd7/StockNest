# StockNest ML service — copy to ml-service/.env (loaded by app/config.py).
# Point at the same MongoDB the Node backend uses so the ML service reads the
# live Sales Master. Leave MONGO_URI unset/empty to use the Excel fallback.
MONGO_URI=mongodb://127.0.0.1:27017/stocknest
MONGO_DB=stocknest
# SALES_EXCEL_FALLBACK_PATH=data/04_Sales_Master.xlsx
